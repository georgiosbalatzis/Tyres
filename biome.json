{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!public/data",
      "!.cache",
      "!test-results",
      "!playwright-report",
      "!.idea",
      "!tests/fixtures",
      "!data",
      "!public/f1stories-social.svg"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "security": { "noDangerouslySetInnerHtml": "error" },
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "noImportantStyles": "off" }
    }
  }
}
